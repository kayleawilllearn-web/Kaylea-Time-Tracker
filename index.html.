<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dream Life HQ — Monthly XP</title><style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;color:#423452;background:#fff8fc}*{box-sizing:border-box}body{margin:0;padding:22px}.wrap{max-width:1060px;margin:auto}header{background:linear-gradient(110deg,#ffe2f0,#eee7ff 70%,#dbf8ef);padding:26px;border-radius:24px;box-shadow:0 8px 35px #b99ab31f}h1{margin:4px 0 8px;font-size:clamp(26px,4vw,39px)}p{line-height:1.5}.muted{color:#796d88}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.15em;color:#94558b}.pill{display:inline-block;padding:6px 10px;background:#fff9;border-radius:99px;font-size:12px;font-weight:700}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:18px 0}.stat,.card{border-radius:18px;padding:17px;background:white;box-shadow:0 4px 22px #8c728118}.stat strong{font-size:28px;display:block}.stat small{color:#75667f}.bar{height:18px;background:#fff;border-radius:20px;margin:15px 0 6px;overflow:hidden}.bar>div{height:100%;width:0;background:linear-gradient(90deg,#f79bc7,#aa89f1);transition:width .25s;border-radius:20px}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.card h2{font-size:17px;margin:0 0 12px}.quest{display:flex;align-items:flex-start;gap:10px;padding:11px;border-radius:12px;background:#f9f5fc;margin:8px 0;cursor:pointer}.quest input{width:19px;height:19px;accent-color:#bc70b8;flex-shrink:0;margin-top:2px}.quest b{display:block;font-size:14px}.quest small{color:#786d82}.chip{float:right;font-size:11px;border-radius:20px;padding:4px 7px;background:#fff;color:#895b8e}.rewards{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.reward{background:#f7f1ff;padding:12px;border-radius:14px;text-align:center;opacity:.52}.reward.unlocked{opacity:1;background:#ffe6f1;outline:2px solid #ed9dca}.reward b{display:block}.reward small{font-size:12px}.controls{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px;align-items:center}button,select,input[type=number]{font:inherit;border-radius:12px;border:1px solid #dfcfe5;padding:10px 12px;background:#fff;color:#51405c}button{cursor:pointer;font-weight:700}button:hover{background:#f9edf7}.note{font-size:13px;color:#73647e}footer{margin:22px 0 10px}.pink{border-top:5px solid #f5a8ce}.purple{border-top:5px solid #c6b0f6}.blue{border-top:5px solid #9dcaff}.green{border-top:5px solid #aceac3}.yellow{border-top:5px solid #f6d88c}.full{grid-column:1/-1}@media(max-width:680px){.cards{grid-template-columns:1fr}.stats{grid-template-columns:repeat(3,1fr)}.stat{padding:11px}.stat strong{font-size:22px}.rewards{grid-template-columns:repeat(2,1fr)}}
</style></head><body><main class="wrap"><header><span class="eyebrow">✦ MY DREAM LIFE HQ</span><h1>🎀 Monthly XP Quest</h1><p>Every little win counts. Pick tasks when you have energy; no strict daily routine.</p><div class="controls"><label for="month"><strong>Month:</strong></label><input type="month" id="month"><span class="pill">🌸 10 quests · 10 XP each</span></div><div class="stats"><div class="stat"><strong id="xp">0</strong><small>XP earned</small></div><div class="stat"><strong id="percent">0%</strong><small>Monthly progress</small></div><div class="stat"><strong id="done">0/10</strong><small>Quests completed</small></div></div><div class="bar" role="progressbar" aria-label="Monthly progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="bar"><div id="fill"></div></div><p id="cheer" class="muted">Pick one tiny quest whenever it feels good.</p></header>
<section class="cards" style="margin-top:18px">
<div class="card pink"><h2>🎤 Music artist era</h2><div id="music"></div></div>
<div class="card purple"><h2>💜 Career glow-up</h2><div id="career"></div></div>
<div class="card green"><h2>🚗 Driving freedom</h2><div id="driving"></div></div>
<div class="card blue"><h2>🌏 Languages</h2><div id="languages"></div></div>
<div class="card yellow"><h2>💻 Coding playground</h2><div id="coding"></div></div>
<div class="card pink"><h2>🎁 Your reward shop</h2><div class="rewards" id="rewards"></div><p class="note">100% unlocks permission to enjoy your planned treat—not an obligation to spend money.</p><label class="note">Max treat budget (£): <input type="number" id="budget" min="0" step="1" style="width:85px" placeholder="20"></label></div>
<div class="card full"><h2>✨ How the formulas work</h2><p><strong>XP earned</strong> = completed quests × 10. <strong>Monthly progress</strong> = XP earned ÷ 100 × 100%. <strong>Reward unlocks</strong> = 25%, 50%, 75%, and 100%. Your checkboxes are saved in this browser for each month automatically.</p><p class="note">Data is stored on this device/browser, not synced to xTiles or other devices. To change the quest list or embed this in xTiles as a live widget, it would need hosting and a compatible embed setup.</p><div class="controls"><button id="reset">Reset selected month</button><button id="export">Export progress backup</button><label>Import backup <input type="file" id="import" accept="application/json" style="max-width:200px"></label></div></div>
</section><footer class="note">🌷 An incomplete month is not a failed month. This tracker is for encouragement, not pressure.</footer></main><script>
const qs=[['music','Practise three keyboard chords'],['music','Write one chorus'],['music','Learn how one part of music distribution works'],['career','Draft three social post ideas'],['career','Review one post’s results'],['career','Improve one admin checklist'],['driving','Practise 30 theory questions'],['languages','Learn ten Punjabi words'],['languages','Learn ten Mandarin words'],['coding','Finish a mini Python exercise']];
const month=document.querySelector('#month'), budget=document.querySelector('#budget');const now=new Date();month.value=now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0');const key=()=> 'dreamlife-xp-'+month.value;const read=()=>{try{return JSON.parse(localStorage.getItem(key()))||{}}catch{return {}}};function write(s){localStorage.setItem(key(),JSON.stringify(s))}
function render(){let s=read();for(const cat of ['music','career','driving','languages','coding'])document.getElementById(cat).innerHTML='';qs.forEach(([cat,title],i)=>{const lab=document.createElement('label');lab.className='quest';let box=document.createElement('input');box.type='checkbox';box.checked=!!s[i];box.onchange=()=>{let a=read();a[i]=box.checked;write(a);render()};let span=document.createElement('span');let t=document.createElement('b');t.textContent=title;let sub=document.createElement('small');sub.textContent='Any day · +10 XP';span.append(t,sub);lab.append(box,span);document.getElementById(cat).append(lab)});let n=qs.filter((_,i)=>s[i]).length,p=n*10;document.querySelector('#xp').textContent=p;document.querySelector('#percent').textContent=p+'%';document.querySelector('#done').textContent=n+'/10';document.querySelector('#fill').style.width=p+'%';document.querySelector('#bar').setAttribute('aria-valuenow',p);document.querySelector('#cheer').textContent=p===100?'👑 100% complete! You unlocked your planned treat!':p>=50?'🌟 Look at that progress! Keep choosing what feels manageable.':p>0?'💗 You showed up for yourself. That counts.':'Pick one tiny quest whenever it feels good.';document.querySelector('#rewards').innerHTML='';[[25,'☕','Cosy treat'],[50,'🛁','Self-care night'],[75,'✨','Wish-list pick'],[100,'👑','Planned purchase']].forEach(([threshold,emoji,name])=>{let el=document.createElement('div');el.className='reward '+(p>=threshold?'unlocked':'');el.innerHTML='<b>'+emoji+' '+threshold+'%</b><small>'+name+'</small>';document.querySelector('#rewards').append(el)});budget.value=localStorage.getItem('dreamlife-budget')||''}
month.onchange=render;budget.onchange=()=>localStorage.setItem('dreamlife-budget',budget.value);document.querySelector('#reset').onclick=()=>{if(confirm('Clear all completed quests for '+month.value+'?')){localStorage.removeItem(key());render()}};document.querySelector('#export').onclick=()=>{let all={};for(let i=0;i<localStorage.length;i++){let k=localStorage.key(i);if(k.startsWith('dreamlife-xp-')||k==='dreamlife-budget')all[k]=localStorage.getItem(k)};let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(all,null,2)],{type:'application/json'}));a.download='dream-life-xp-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};document.querySelector('#import').onchange=async(e)=>{let f=e.target.files?.[0];if(!f)return;try{let data=JSON.parse(await f.text());if(!confirm('Import saved progress from this file?'))return;for(const [k,v]of Object.entries(data))if(k.startsWith('dreamlife-xp-')||k==='dreamlife-budget')localStorage.setItem(k,String(v));render()}catch{alert('Could not read backup file.')}};render();
</script></body></html>
